{
  "name": "accontrol",
  "version": "0.20.4",
  "description": "ACCONTROL 2.0 - plataforma de finanzas personales (Etapa 4: prototipo local con deudas, presupuesto, exportación, patrimonio neto y calculadoras, PWA)",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node tools/serve.mjs",
    "test": "node --test",
    "typecheck": "tsc -p jsconfig.json",
    "precache": "node tools/make-precache.mjs",
    "roles-css": "node tools/make-roles-css.mjs",
    "build": "node tools/build.mjs",
    "android": "npm run build && npx cap sync android",
    "android:abrir": "npx cap open android",
    "android:firma": "node tools/android-apk.mjs firma",
    "android:apk": "node tools/android-apk.mjs",
    "android:iconos": "node tools/android-apk.mjs iconos"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
